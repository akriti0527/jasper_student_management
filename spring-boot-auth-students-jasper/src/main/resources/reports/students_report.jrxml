<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="students_report"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30">

    <parameter name="generatedBy" class="java.lang.String"/>
    <parameter name="totalStudents" class="java.lang.Integer"/>

    <field name="rollNo" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="department" class="java.lang.String"/>
    <field name="course" class="java.lang.String"/>
    <field name="gpa" class="java.lang.Double"/>
    <field name="email" class="java.lang.String"/>

    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="65" backcolor="#1E293B"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="350" height="25" forecolor="#38BDF8"/>
                <textElement verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Student Management Report]]></text>
            </staticText>
            <textField>
                <reportElement x="15" y="38" width="300" height="18" forecolor="#CBD5E1"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{generatedBy} + " | Total: " + $P{totalStudents}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="380" y="38" width="140" height="18" forecolor="#CBD5E1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="24" backcolor="#0F172A"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#334155"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="2" width="60" height="20" forecolor="#38BDF8"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Roll No]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="2" width="110" height="20" forecolor="#38BDF8"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="185" y="2" width="120" height="20" forecolor="#38BDF8"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Email]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="2" width="80" height="20" forecolor="#38BDF8"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Dept]]></text>
            </staticText>
            <staticText>
                <reportElement x="395" y="2" width="90" height="20" forecolor="#38BDF8"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Course]]></text>
            </staticText>
            <staticText>
                <reportElement x="490" y="2" width="40" height="20" forecolor="#38BDF8"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[GPA]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <line>
                <reportElement x="0" y="21" width="535" height="1" forecolor="#E2E8F0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <textField>
                <reportElement x="5" y="2" width="60" height="18"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{rollNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="2" width="110" height="18"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="185" y="2" width="120" height="18"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="310" y="2" width="80" height="18"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{department}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="395" y="2" width="90" height="18"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{course}]]></textFieldExpression>
            </textField>
            <textField pattern="0.0">
                <reportElement x="490" y="2" width="40" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{gpa}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="375" y="5" width="150" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="5" y="5" width="200" height="18" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Confidential - Academic Portal]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>
